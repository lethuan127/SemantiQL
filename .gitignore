# Python (the project is Python-only; see .specify/memory/constitution.md)
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.log

# uv.lock is committed on purpose: strangers get the versions CI uses.

# Env & secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/

# Data files (keep examples explicit)
*.duckdb
*.sqlite

# Claude Code writes an absolute path to the installed marketplace here, so it can never be
# committed: it would carry one developer's home directory into everyone else's checkout.
.claude/settings.local.json

# Agent worktrees are scratch checkouts, never repository content.
.claude/worktrees/
